<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>FluentEventBus.AsyncApi</PackageId>
        <Description>AsyncAPI 3.0 document generation for FluentEventBus: builds the spec from your subscription profiles and event naming — no extra annotations required.</Description>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Neuroglia.AsyncApi.Core" Version="3.0.6" />
        <PackageReference Include="Neuroglia.AsyncApi.IO" Version="3.0.6" />
        <PackageReference Include="JsonSchema.Net.Generation" Version="4.6.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FluentEventBus\FluentEventBus.csproj" />
    </ItemGroup>

</Project>
